        },
        "parent": {
          "$ref": "#/$defs/reference"
        },
        "role": {
          "enum": [
            "/Document",
            "/H1",
            "/H2",
            "/P",
            "/Table",
            "/Caption",
            "/THead",
            "/TBody",
            "/TR",
            "/TH",
            "/TD",
            "/Span"
          ]
        },
        "page_reference": {
          "oneOf": [
            {
              "$ref": "#/$defs/reference"
