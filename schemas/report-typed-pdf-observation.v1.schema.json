              "minimum": 0,
              "maximum": 19999
            },
            "kind": {
              "const": "node"
            },
            "reference": {
              "$ref": "#/$defs/reference"
            }
          },
          "required": [
            "ordinal",
            "kind",
            "reference"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ordinal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 19999
            },
            "kind": {
              "const": "mcid"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 19999
            }
          },
          "required": [
            "ordinal",
            "kind",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "node": {
