      ],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "maxLength": 64,
      "minLength": 64
    },
    "number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^/[^\\s]+(?![\\s\\S])"
    },
    "native_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "part": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "codes"
            },
            {
              "type": "string",
              "maxLength": 4194304,
              "pattern": "^(?:[0-9a-f]{4})*(?![\\s\\S])"
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": false
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "adjust"
            },
            {
              "$ref": "#/$defs/number"
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": false
        }
      ]
    },
    "child": {
      "oneOf": [
