      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "structure_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "mcids": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "structure_visits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "fonts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "cmap_records": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "cmap_decoded_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 524288
        },
        "decoded_stream_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "operations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "decoded_text_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "glyph_codes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "text_scalars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        }
      },
      "required": [
        "structure_nodes",
        "mcids",
        "structure_visits",
        "fonts",
        "cmap_records",
        "cmap_decoded_bytes",
        "decoded_stream_bytes",
        "operations",
        "decoded_text_bytes",
        "glyph_codes",
        "text_scalars"
      ],
      "additionalProperties": false
    },
    "trace": {
      "$ref": "#/$defs/trace"
    },
    "source_text_equivalence_verified": {
      "type": "boolean",
      "const": false
    },
    "rendered_glyphs_verified": {
      "type": "boolean",
      "const": false
    },
    "reading_order_verified": {
      "type": "boolean",
      "const": false
    },
    "accessibility_qualified": {
      "type": "boolean",
      "const": false
    },
    "scientific_equivalence_verified": {
      "type": "boolean",
      "const": false
    },
    "aggregate_job_resources_qualified": {
      "type": "boolean",
      "const": false
    },
    "worker_results_authenticated": {
      "type": "boolean",
      "const": false
    },
    "release_authorized": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "source_association",
    "pdf_sha256",
    "pdf_byte_count",
    "page_count",
    "parser_version",
    "profile_sha256",
    "limits",
    "counts",
    "trace",
    "source_text_equivalence_verified",
    "rendered_glyphs_verified",
    "reading_order_verified",
    "accessibility_qualified",
    "scientific_equivalence_verified",
    "aggregate_job_resources_qualified",
    "worker_results_authenticated",
    "release_authorized"
