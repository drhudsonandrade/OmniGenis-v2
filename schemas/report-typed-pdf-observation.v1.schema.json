              "maxItems": 6,
              "minItems": 6
            }
          },
          "required": [
            "ordinal",
            "operator",
            "operands"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ordinal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 19999
            },
            "operator": {
              "enum": [
                "rg"
              ]
            },
            "operands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/number"
