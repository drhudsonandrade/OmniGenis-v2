        {
          "type": "object",
          "properties": {
            "ordinal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 19999
            },
            "operator": {
              "enum": [
                "gs"
              ]
            },
            "operands": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/name"
