            {
              "type": "null"
            }
          ]
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/native_id"
          },
          "maxItems": 1,
          "minItems": 0
        }
      },
      "required": [
        "reference",
        "parent",
        "role",
        "page_reference",
        "children_form",
        "children",
        "table_attribute",
        "native_id",
        "headers"
      ],
      "additionalProperties": false
