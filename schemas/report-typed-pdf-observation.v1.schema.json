{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omnigenis:report-typed-pdf-observation:v1",
  "title": "Private physical typed PDF observation",
  "description": "Exact native structure and declared same-font text. No source equivalence, rendered glyph, accessibility or release qualification.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "profile_id": {
      "const": "typed-pdf-physical-observation-v1"
    },
    "status": {
      "const": "PHYSICAL_TEXT_OBSERVED"
    },
    "source_association": {
      "const": "NOT_ESTABLISHED"
    },
    "pdf_sha256": {
      "$ref": "#/$defs/digest"
    },
    "pdf_byte_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "page_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "parser_version": {
      "const": "7.1.0"
    },
    "profile_sha256": {
      "$ref": "#/$defs/digest"
    },
    "limits": {
      "type": "object",
      "properties": {
        "memory_bytes": {
          "const": 268435456
        },
        "cpu_seconds": {
          "const": 5
        },
        "file_bytes": {
          "const": 4194304
        },
        "open_files": {
          "const": 128
        }
      },
      "required": [
        "memory_bytes",
        "cpu_seconds",
        "file_bytes",
        "open_files"
