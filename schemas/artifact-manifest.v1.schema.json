{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omnigenis:schema:artifact-manifest:1.0.0",
  "title": "ArtifactManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "artifact_kind", "media_type", "sha256", "size_bytes", "producer_execution_profile_id", "parent_artifact_ids"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_kind": {"type": "string", "minLength": 1},
    "media_type": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "producer_execution_profile_id": {"type": "string", "minLength": 1},
    "parent_artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
