{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omnigenis:schema:interoperability-profile:1.0.0",
  "title": "InteroperabilityProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","profile_id","standard_name","standard_version","base_version",
    "source_url","license","activation_state","adapter_enabled","network_access",
    "subject_identity_policy","scientific_semantics","unsupported_behavior","scope","known_issues"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "standard_name": {"type":"string","minLength":1},
    "standard_version": {"type":"string","minLength":1},
    "base_version": {"type":["string","null"]},
    "source_url": {"type":"string","pattern":"^https://"},
    "license": {"enum":["CC-BY-4.0","BSD-3-Clause","Apache-2.0"]},
    "activation_state": {"const":"PROFILE_DECLARED_ADAPTER_PENDING"},
    "adapter_enabled": {"const":false},
    "network_access": {"const":"FORBIDDEN_DURING_PROJECTION"},
    "subject_identity_policy": {"enum":["OPTIONAL_EXPLICIT_ONLY","REQUIRED_EXPLICIT_FOR_SUBJECT_PROJECTION","NOT_APPLICABLE"]},
    "scientific_semantics": {"const":"PROJECT_EXISTING_CANONICAL_E1A_ONLY"},
    "unsupported_behavior": {"const":"FAIL_CLOSED"},
    "scope": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "known_issues": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}
