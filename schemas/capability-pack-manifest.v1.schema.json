{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omnigenis:schema:capability-pack-manifest:1.0.0",
  "title": "CapabilityPackManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capability_id", "capability_version", "real_use_case", "owner_priority", "upstream_status", "license", "supported_profile", "resource_budget", "input_fixture", "output_contract", "known_issues", "security", "disable_path"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "capability_id": {"type": "string", "minLength": 1},
    "capability_version": {"type": "string", "minLength": 1},
    "real_use_case": {"type": "string", "minLength": 1},
    "owner_priority": {"type": "string", "minLength": 1},
    "upstream_status": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "supported_profile": {"type": "string", "minLength": 1},
    "resource_budget": {"type": "string", "minLength": 1},
    "input_fixture": {"type": "string", "minLength": 1},
    "output_contract": {"type": "string", "minLength": 1},
    "known_issues": {"type": "string", "minLength": 1},
    "security": {"type": "string", "minLength": 1},
    "disable_path": {"type": "string", "minLength": 1}
  }
}
